# Exemple d'environnement de la sauvegarde de production de VFF.
# Copier vers /etc/vff/backup.env (propriétaire de l'utilisateur de sauvegarde, mode 600) et remplir.
# AUCUN identifiant réel dans ce dépôt : ce fichier ne contient que des valeurs fictives.

# --- PostgreSQL (variables standard libpq) ---
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=vff_backup            # rôle en lecture seule : GRANT pg_read_all_data ; CREATEDB pour l'essai de restauration
PGDATABASE=vff
# Mot de passe : de préférence un fichier ~/.pgpass (mode 600) ou PGPASSFILE=/etc/vff/pgpass, pas de PGPASSWORD ici.
PGPASSFILE=/etc/vff/pgpass
# PG_BIN_DIR=/usr/lib/postgresql/18/bin   # si les binaires du serveur ne sont pas dans le PATH (version >= serveur)

# --- Stockage local ---
BACKUP_DIR=/var/backups/vff   # contient daily/ weekly/ monthly/ (créés par le script)
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=6
DUMP_JOBS=2                   # fichiers lus en parallèle à la restauration ; le dump -Fc reste séquentiel

# --- Envoi chiffré hors site (restic vers un S3 suisse, recommandé) ---
# Laisser RESTIC_REPOSITORY vide pour ne rien envoyer (sauvegarde locale seule).
RESTIC_REPOSITORY=s3:https://s3.exemple-suisse.invalid/vff-prod-db
RESTIC_PASSWORD_FILE=/etc/vff/restic-password    # mot de passe du dépôt (mode 600) ; copie dans le coffre d'UnxWares
AWS_ACCESS_KEY_ID=CLE_FICTIVE
AWS_SECRET_ACCESS_KEY=SECRET_FICTIF
# Les mêmes politiques que sur le local sont appliquées côté restic (voir RETENTION_*).

# --- Alertes (battement) ---
# Adresse appelée à la fin d'une sauvegarde RÉUSSIE (moniteur « push » de Kener ou « heartbeat » de GlitchTip).
# L'absence d'appel dans le délai prévu déclenche l'alerte : c'est la protection contre le silence (timer mort,
# serveur éteint). En cas d'échec détecté, FAIL_SUFFIX est ajouté à l'adresse (ex. « ?status=down » ou « /fail »).
HEARTBEAT_URL=https://status.exemple.invalid/api/push/CLE_FICTIVE
HEARTBEAT_FAIL_SUFFIX=?status=down

# --- Essai de restauration ---
APP_DIR=/srv/vff               # dossier de l'application (contient artisan) ; vffbackup doit être du groupe vff
ARTISAN_CMD="php artisan"      # PHP du serveur, qui reçoit les variables DB_* du script ; « bin/php artisan » sur un poste
                               # (il ne transmet que DB_DATABASE : suffisant sans cache de configuration)
COUNT_TABLES="lines stations eras line_sections line_segments line_events media users"
COUNT_TOLERANCE_PCT=2          # écart toléré entre les comptes de la sauvegarde et ceux de la base restaurée
INVARIANTS_STRICT=0            # 1 : un invariant de données violé fait échouer l'essai (0 : signalé seulement)
RESTORE_HEARTBEAT_URL=https://status.exemple.invalid/api/push/AUTRE_CLE_FICTIVE
