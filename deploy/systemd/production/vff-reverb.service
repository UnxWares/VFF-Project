# Serveur WebSocket Laravel Reverb (temps réel). Pour le SERVEUR de production, jamais sur un poste de travail.
# Installation : docs/DEPLOIEMENT-SERVICES.md. Écoute 127.0.0.1:8080 (REVERB_SERVER_HOST/PORT), nginx ne
# transmet que /app/ (deploy/nginx/snippets/vff-reverb.conf).
[Unit]
Description=VFF - Laravel Reverb (WebSocket)
After=network-online.target valkey.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=vff
Group=vff
WorkingDirectory=/srv/vff
Environment=APP_ENV=production
ExecStart=/usr/bin/php artisan reverb:start --no-interaction
# Rechargement propre au déploiement : "systemctl reload vff-reverb" (reverb:restart, via un signal de cache).
ExecReload=/usr/bin/php artisan reverb:restart --no-interaction
Restart=always
RestartSec=3
TimeoutStopSec=30
# Une connexion WebSocket ouvre un descripteur de fichier (plafond du site : REVERB_APP_MAX_CONNECTIONS).
LimitNOFILE=8192
MemoryHigh=384M
MemoryMax=512M
TasksMax=256
# Durcissement (systemd.exec(5))
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0027
ReadWritePaths=/srv/vff/storage /srv/vff/bootstrap/cache
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vff-reverb

[Install]
WantedBy=multi-user.target
