# Compression brotli, si le module ngx_brotli est installé (paquet nginx-module-brotli).
# Absent de l'image officielle nginx. Pour l'activer :
#   1. ajouter en tête de /etc/nginx/nginx.conf :  load_module modules/ngx_http_brotli_filter_module.so;
#                                                  load_module modules/ngx_http_brotli_static_module.so;
#   2. copier ce fichier en vff-brotli.conf dans /etc/nginx/vff-optional/ (le site inclut *.conf de ce dossier)
#   3. nginx -t puis rechargement.
brotli on;
brotli_comp_level 5;
brotli_min_length 512;
brotli_types text/plain text/css text/xml application/json application/geo+json application/javascript
             text/javascript application/xml image/svg+xml application/manifest+json application/graphql-response+json
             application/vnd.mapbox-vector-tile application/x-protobuf font/ttf;
