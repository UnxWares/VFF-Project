{
    "name": "vff/vff",
    "type": "project",
    "description": "VFF - Voies Ferrées de France. Encyclopédie collaborative du rail français.",
    "keywords": ["laravel", "railway", "encyclopedia", "france", "openstreetmap", "postgis"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "clickbar/laravel-magellan": "^2.3",
        "dedoc/scramble": "^0.13.55",
        "guzzlehttp/guzzle": "^8.5.4",
        "inertiajs/inertia-laravel": "^3.7",
        "laravel/framework": "^13.43",
        "laravel/mcp": "^1.2.1",
        "laravel/reverb": "^1.14",
        "laravel/sanctum": "^4.5",
        "laravel/tinker": "^3.2",
        "nuwave/lighthouse": "^6.74.1",
        "predis/predis": "^3.7.1",
        "sentry/sentry-laravel": "^4.31"
    },
    "require-dev": {
        "brianium/paratest": "^7.29",
        "fakerphp/faker": "^1.24.1",
        "infection/infection": "^0.35.12",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.3",
        "laravel/pint": "^1.32.3",
        "mll-lab/laravel-graphiql": "^4.2",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.6",
        "phpunit/phpunit": "^13.4.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm exec concurrently -c '#93c5fd,#c4b5fd,#fb923c,#fb7185' 'php artisan serve' 'php artisan queue:listen --tries=1' 'php artisan pail --timeout=0' 'pnpm dev' --names=server,queue,logs,vite --kill-others-on-fail"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=2G --ansi"
        ],
        "analyse:baseline": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=2G --generate-baseline --allow-empty-baseline"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test"
        ],
        "test:static": "@php artisan test tests/Unit/Static",
        "test:parallel": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --parallel --processes=4"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d pcov.enabled=1 vendor/bin/phpunit --colors=never --no-progress --coverage-text --only-summary-for-coverage-text --coverage-clover=storage/app/reports/coverage/clover.xml --coverage-html=storage/app/reports/coverage/html",
            "@php scripts/coverage-summary.php storage/app/reports/coverage/clover.xml"
        ],
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/infection --threads=4 --only-covering-test-cases --show-mutations=20 --no-progress"
        ],
        "test:mutation:critical": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/infection -c tests/Mutation/Critical/infection.json5 --threads=4 --only-covering-test-cases --show-mutations=20 --no-progress"
        ]
    },
    "scripts-descriptions": {
        "analyse": "Analyse statique PHPStan + Larastan (niveau 6, baseline phpstan-baseline.neon)",
        "analyse:baseline": "Régénère phpstan-baseline.neon (dette existante, après revue)",
        "test": "PHPUnit (base de test *_test, jamais la base de dev)",
        "test:static": "Contrôles statiques du projet (tirets, clés i18n, palette, routes), sans base",
        "test:parallel": "PHPUnit en 4 processus (bases <base>_test_1 à _4, créées par Laravel)",
        "test:coverage": "Couverture (pcov activé à la demande) : résumé texte + Clover + HTML dans storage/app/reports/coverage",
        "test:mutation": "Tests de mutation Infection (4 threads) sur les services purs critiques (infection.json5), long",
        "test:mutation:critical": "Tests de mutation Infection (4 threads) des règles métier critiques : moteur d'historique, desserte des gares, validation à deux, matériel, images (tests/Mutation/Critical), long"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
