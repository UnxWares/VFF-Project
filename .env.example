APP_NAME=VFF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=365
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données - PostgreSQL 18 + PostGIS 3.6 (conteneur Docker exposé sur 127.0.0.1:5432)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vff
DB_USERNAME=vff
DB_PASSWORD=vff

# Cache & file d'attente - Valkey (fork BSD de Redis, conteneur `valkey` parle le protocole RESP)
# Diffusion temps réel : `null` (rien ne part) tant que REALTIME_ENABLED vaut false ; `reverb` en production
BROADCAST_CONNECTION=null
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Bien que les clés soient nommées REDIS_*, le conteneur cible est Valkey (fork BSD compatible RESP)
# Client recommandé : phpredis (extension PHP native) ; fallback predis (composer require predis/predis)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Temps réel (suivi des contributions en direct, docs/DEPLOIEMENT-NGINX.md section « Temps réel »).
# Désactivé tant que la production n'a pas de serveur Reverb (php artisan reverb:start).
REALTIME_ENABLED=false
REVERB_APP_ID=
REVERB_APP_KEY=                           # publique (transmise au navigateur)
REVERB_APP_SECRET=                        # jamais transmise
# Où Reverb écoute, et où Laravel lui publie les événements (même machine, sans nginx)
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Pages autorisées à se connecter (noms d'hôte séparés par des virgules ; par défaut celui d'APP_URL)
REVERB_ALLOWED_ORIGINS=
# Plafond de connexions WebSocket simultanées de tout le serveur (vide ou absent : 1000)
REVERB_APP_MAX_CONNECTIONS=1000
# Plusieurs serveurs Reverb relayés par Valkey (connexion REDIS_*)
REVERB_SCALING_ENABLED=false
# Adresse publique qu'ouvre le navigateur (nginx) ; par défaut l'hôte d'APP_URL en https sur 443
REALTIME_CLIENT_HOST=
REALTIME_CLIENT_PORT=443
REALTIME_CLIENT_SCHEME=https
# Abonnements GraphQL : diffuseur (reverb, ou pusher pour un autre serveur compatible auto-hébergé)
LIGHTHOUSE_BROADCASTER=reverb
# Abonnements GraphQL ouverts par jour par compte (ou par adresse IP sans compte)
REALTIME_SUBSCRIPTIONS_PER_DAY=100

# Mail (dev) - pointer vers Mailpit ou Mailhog si on en ajoute un
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@vff.local"
MAIL_FROM_NAME="${APP_NAME}"
# Adresse de contact de l'équipe (alertes de service, ex. dernier administrateur inactif)
MAIL_CONTACT_ADDRESS=contact@vff-project.org

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5173

# Cartographie
VITE_MAP_TILES_PROVIDER=maptiler          # maptiler | stadia | osm-raw
VITE_MAPTILER_KEY=                        # clé API MapTiler (free tier sur maptiler.com)
VITE_STADIA_KEY=                          # alternative à MapTiler

# Relais des vignettes de Wikimedia Commons (docs/DEPLOIEMENT-NGINX.md, « Relais des vignettes de Commons »).
# true en production : les images de Commons sont servies par VFF, sans cookie tiers de Wikimedia.
VFF_COMMONS_PROXY=false
VFF_COMMONS_PROXY_CACHE_MB=2048
VFF_COMMONS_PROXY_ACCEL_REDIRECT=                # /_commons/ derrière nginx

# Médias sous licence non commerciale (CC BY-NC…) : false les masque partout (site, API, MCP, relais).
VFF_MEDIA_SHOW_NON_COMMERCIAL=true
# Médias d'un fonds à licence « incertaine » (source_rights.php, statut incertain) : false les masque partout.
VFF_MEDIA_SHOW_UNCERTAIN=true

# Import OSM
OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_USER_AGENT="VFF-Bot/1.0 (+https://vff-project.org)"

# Ports exposés (Docker → hôte). Override possible.
DB_PORT=5432
VALKEY_PORT=6379
ADMINER_PORT=8080

# Politique de sécurité du contenu (docs/SECURITE-CSP.md)
# true en production (bloquante, décision du 22/11/2026) ; false en développement, où elle ne fait que signaler
# (Report-Only) : à laisser à false si le serveur de dev Vite l'exige, à passer à true pour un essai avant la mise en ligne.
CSP_ENFORCE=false

# Suivi des erreurs et de la disponibilité (docs/SUIVI-ERREURS.md, docs/SUIVI-PRODUCTION.md)
APP_VERSION=
HEALTH_TOKEN=                             # jeton de /up/details (vide : état seul, sans détail)
# HEALTH_SCHEDULER_EXPECTED=true         # contrôle `scheduler` de /up/details (défaut : actif en production, ignoré ailleurs)
SENTRY_LARAVEL_DSN=                       # adresse DSN d'un GlitchTip ou Bugsink auto-hébergé (vide : rien n'est envoyé)
SENTRY_SAMPLE_RATE=0.5
CLIENT_ERRORS_PER_MINUTE=10
VITE_APP_VERSION=
