<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!--
        Bugs connus, laissés en échec en attendant leur correction (souvent dans un
        fichier en cours de modification) : exclus par défaut.
        Les lancer : option group de phpunit, valeur known-bug.
    -->
    <groups>
        <exclude>
            <group>known-bug</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Base de test DÉDIÉE (PostgreSQL + PostGIS) : les tests Feature utilisent
            RefreshDatabase, qui vide la base à chaque run. Ne JAMAIS pointer sur `vff`.
            Création : `make test-db` (ou cf. README, section « Tests »).
            `force` : l'emporte sur toute variable DB_DATABASE héritée du shell / du .env.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="vff_test" force="true"/>
        <!-- Schéma GraphQL relu à chaque test : un cache (bootstrap/cache/lighthouse-schema.php) périmé ferait tester l'ancien schéma. -->
        <env name="LIGHTHOUSE_SCHEMA_CACHE_ENABLE" value="false"/>
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
