{
    "name": "vff",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier --write \"{resources/{js,css}/**/*.{js,svelte,css},tests/js/**/*.js,scripts/**/*.{js,mjs},*.config.js}\"",
        "lint": "prettier --check \"{resources/{js,css}/**/*.{js,svelte,css},tests/js/**/*.js,scripts/**/*.{js,mjs},*.config.js}\"",
        "lint:js": "eslint .",
        "check": "node scripts/svelte-check.mjs",
        "docs:graphql": "magidoc generate --file resources/docs/graphql/magidoc.mjs --clean && node resources/docs/graphql/postbuild.mjs",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/svelte": "^3.0",
        "@magidoc/cli": "7.0.0",
        "@maplibre/maplibre-gl-style-spec": "^24.8.5",
        "@scalar/api-reference": "1.73.0",
        "@sveltejs/vite-plugin-svelte": "^7.0",
        "axios": "^1.7",
        "concurrently": "^9.1",
        "eslint": "^10.13.0",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^3.0",
        "lefthook": "^2.2.2",
        "prettier": "^3.3",
        "prettier-plugin-svelte": "^3.3",
        "svelte": "^5.0",
        "svelte-check": "^4.7.7",
        "swagger-ui-dist": "5.33.1",
        "typescript": "^6.0.3",
        "vite": "^8.0",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@fontsource/gabarito": "5.3.0",
        "@fontsource/inter": "5.3.0",
        "@fontsource/lato": "5.3.0",
        "@fontsource/montserrat": "5.3.0",
        "bootstrap-icons": "^1.11",
        "i18next": "^26.0",
        "maplibre-gl": "^5.0",
        "svelte-i18next": "^2.2"
    },
    "scarfSettings": {
        "enabled": false
    }
}
