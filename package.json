{
    "name": "vff",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier --write \"{resources/{js,css}/**/*.{js,svelte,css},tests/js/**/*.js,tests/e2e/**/*.js,scripts/**/*.{js,mjs},*.config.js}\"",
        "lint": "prettier --check \"{resources/{js,css}/**/*.{js,svelte,css},tests/js/**/*.js,tests/e2e/**/*.js,scripts/**/*.{js,mjs},*.config.js}\"",
        "lint:js": "eslint .",
        "check": "node scripts/svelte-check.mjs",
        "docs:graphql": "magidoc generate --file resources/docs/graphql/magidoc.mjs --clean && node resources/docs/graphql/postbuild.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@inertiajs/svelte": "^3.11.0",
        "@magidoc/cli": "9.0.0",
        "@maplibre/maplibre-gl-style-spec": "^26.9.0",
        "@playwright/test": "^1.65.1",
        "@scalar/api-reference": "1.82.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "axios": "^1.21.1",
        "concurrently": "^10.0.7",
        "eslint": "^10.15.0",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.2.1",
        "lefthook": "^2.2.2",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^3.5.2",
        "svelte": "^5.58.0",
        "svelte-check": "^4.7.8",
        "swagger-ui-dist": "5.35.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "@fontsource/gabarito": "5.3.0",
        "@fontsource/inter": "5.3.0",
        "@fontsource/lato": "5.3.0",
        "@fontsource/montserrat": "5.3.0",
        "@protomaps/basemaps": "5.7.2",
        "bootstrap-icons": "^1.13.2",
        "i18next": "^27.2.2",
        "laravel-echo": "^2.6.3",
        "maplibre-gl": "^6.19.0",
        "pmtiles": "4.5.0",
        "pusher-js": "^8.6.0"
    },
    "scarfSettings": {
        "enabled": false
    }
}
