<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration PHPUnit des tests de mutation des gares (Infection, cf. infection.json5).
    Chaque thread Infection reçoit TEST_TOKEN=<n> : Laravel migre « <base>_test_<n> ».
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../../vendor/autoload.php"
         colors="false"
>
    <testsuites>
        <testsuite name="Mutation">
            <file>../../Feature/StationCorrectionsApplyTest.php</file>
            <file>../../Feature/StationCorrectionsTest.php</file>
            <file>../../Feature/StationCorrectionsMutationTest.php</file>
            <file>../../Unit/StationCorrectionsValidateTest.php</file>
            <file>../../Unit/StationClosureParserHelpersTest.php</file>
            <file>../../Unit/StationClosureParserTest.php</file>
            <file>../../Unit/StationClosureParserMutationTest.php</file>
            <file>../../Unit/StationClosureParserSnapshotsTest.php</file>
            <file>../../Unit/StationClosureParserSentencesTest.php</file>
            <file>../../Unit/StationClosureParserStructureTest.php</file>
            <file>../../Unit/CsvSafeEdgesTest.php</file>
            <file>../../Unit/CsvSafeTest.php</file>
            <file>../../Feature/AuditCsvFormulaTest.php</file>
            <directory>../../Unit/StationAudit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../../../app/Services</directory>
            <directory>../../../app/Support</directory>
        </include>
    </source>
    <php>
        <server name="LARAVEL_PARALLEL_TESTING" value="1"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="vff_test" force="true"/>
        <env name="LIGHTHOUSE_SCHEMA_CACHE_ENABLE" value="false"/>
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>

</phpunit>
