  "dcterms:description": [
   {
    "type": "literal",
    "property_id": 4,
    "property_label": "Description",
    "is_public": true,
    "@value": "Le photographe domine le chemin de fer qui longe la Vienne à Saint-Priest-Taurion, rive droite. Le moulin sous la voie ferrée est celui du meunier Caillaud, dit moulin de la Roche. Le moulin de la rive gauche, en face, est celui du meunier Chilloux, dit moulin de Cintrat. Ce dernier se trouve en réalité à Saint-Just-le-Martel puisque la rivière délimite les deux communes."
   }
  ],
