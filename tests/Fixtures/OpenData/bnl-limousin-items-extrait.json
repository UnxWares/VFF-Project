  "dcterms:description": [
   {
    "type": "literal",
    "property_id": 4,
    "property_label": "Description",
    "is_public": true,
    "@value": "Jean-Baptiste Audiguet (1811-1897) est un des pionniers de la photographie professionnelle à Limoges. Né à Bellac dans un milieu modeste, il se lance dans la photographie à la fin des années 1850 et devient le grand portraitiste de la société limougeaude du Second Empire et de la Troisième République. C'est aussi le premier photographe connu à proposer des vues de la ville et de ses alentours, avec une parfaite maîtrise de la composition et une sensibilité esthétique surprenante. Avec Audiguet, Limoges devient paysage photographique.\n\ncote : 9Fi502/39 (Bfm Limoges)"
   }
  ],
  "dcterms:creator": [
